
#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>
#include <string>
using namespace std;

class NhanVien {
private:
    string maNV;
    string hoTen;
    string phongBan;
    double heSoLuong;
    int soNgayCong;
    double luongThucLinh;

public:
    // Ham nhap thong tin
    void nhap() {
        cin.ignore();
        cout << "Nhap ma nhan vien: ";
        getline(cin, maNV);

        cout << "Nhap ho ten: ";
        getline(cin, hoTen);

        cout << "Nhap phong ban: ";
        getline(cin, phongBan);

        cout << "Nhap he so luong: ";
        cin >> heSoLuong;

        cout << "Nhap so ngay cong: ";
        cin >> soNgayCong;

        tinhLuong();
    }

    // Ham tinh luong thuc linh
    void tinhLuong() {
        luongThucLinh = heSoLuong * soNgayCong * 200000;
    }

    // Ham xuat thong tin
    void xuat() const {
        cout << left
             << setw(12) << maNV
             << setw(25) << hoTen
             << setw(18) << phongBan
             << setw(15) << heSoLuong
             << setw(15) << soNgayCong
             << setw(15) << luongThucLinh
             << endl;
    }

    // Lay ma nhan vien
    string getMaNV() const {
        return maNV;
    }

    // Lay luong thuc linh
    double getLuong() const {
        return luongThucLinh;
    }
};

// Nhap danh sach nhan vien
void nhapDanhSach(vector<NhanVien>& ds) {
    int n;
    do {
        cout << "Nhap so nhan vien (0 < n < 200): ";
        cin >> n;
    } while (n <= 0 || n >= 200);

    ds.clear();

    for (int i = 0; i < n; i++) {
        cout << "\nNhap nhan vien thu " << i + 1 << ":\n";
        NhanVien nv;
        nv.nhap();
        ds.push_back(nv);
    }
}

// In danh sach nhan vien
void xuatDanhSach(const vector<NhanVien>& ds) {
    if (ds.empty()) {
        cout << "Danh sach rong!\n";
        return;
    }

    cout << "\n========== DANH SACH NHAN VIEN ==========\n";

    cout << left
         << setw(12) << "Ma NV"
         << setw(25) << "Ho ten"
         << setw(18) << "Phong ban"
         << setw(15) << "He so luong"
         << setw(15) << "Ngay cong"
         << setw(15) << "Luong"
         << endl;

    for (const NhanVien& nv : ds) {
        nv.xuat();
    }
}

// Sap xep theo luong giam dan
void sapXep(vector<NhanVien>& ds) {
    sort(ds.begin(), ds.end(),
         [](const NhanVien& a, const NhanVien& b) {
             return a.getLuong() > b.getLuong();
         });

    cout << "Da sap xep theo luong giam dan!\n";
}

// Tim kiem theo ma nhan vien
void timKiem(const vector<NhanVien>& ds) {
    string ma;
    cout << "Nhap ma nhan vien can tim: ";
    cin.ignore();
    getline(cin, ma);

    bool timThay = false;

    for (const NhanVien& nv : ds) {
        if (nv.getMaNV() == ma) {
            cout << "\nTim thay nhan vien:\n";
            nv.xuat();
            timThay = true;
        }
    }

    if (!timThay) {
        cout << "Khong tim thay nhan vien!\n";
    }
}

// Them nhan vien tai vi tri cho truoc
void themNhanVien(vector<NhanVien>& ds) {
    if (ds.size() >= 199) {
        cout << "Danh sach da dat gioi han!\n";
        return;
    }

    int vt;
    cout << "Nhap vi tri muon them (1 - "
         << ds.size() + 1 << "): ";
    cin >> vt;

    if (vt < 1 || vt > (int)ds.size() + 1) {
        cout << "Vi tri khong hop le!\n";
        return;
    }

    NhanVien nv;
    cout << "\nNhap thong tin nhan vien moi:\n";
    nv.nhap();

    ds.insert(ds.begin() + vt - 1, nv);

    cout << "Them nhan vien thanh cong!\n";
}

// Xoa nhan vien tai vi tri cho truoc
void xoaNhanVien(vector<NhanVien>& ds) {
    if (ds.empty()) {
        cout << "Danh sach rong, khong the xoa!\n";
        return;
    }

    int vt;
    cout << "Nhap vi tri muon xoa (1 - "
         << ds.size() << "): ";
    cin >> vt;

    if (vt < 1 || vt > (int)ds.size()) {
        cout << "Vi tri khong hop le!\n";
        return;
    }

    ds.erase(ds.begin() + vt - 1);

    cout << "Xoa nhan vien thanh cong!\n";
}

// Chuong trinh chinh
int main() {
    vector<NhanVien> ds;
    int chon;

    do {
        cout << "\n========== MENU QUAN LY NHAN VIEN ==========\n";
        cout << "1. Nhap danh sach nhan vien\n";
        cout << "2. In danh sach nhan vien\n";
        cout << "3. Sap xep theo luong giam dan\n";
        cout << "4. Tim kiem theo ma nhan vien\n";
        cout << "5. Them nhan vien vao vi tri\n";
        cout << "6. Xoa nhan vien tai vi tri\n";
        cout << "0. Thoat chuong trinh\n";
        cout << "============================================\n";
        cout << "Nhap lua chon: ";
        cin >> chon;

        switch (chon) {
            case 1:
                nhapDanhSach(ds);
                break;

            case 2:
                xuatDanhSach(ds);
                break;

            case 3:
                sapXep(ds);
                break;

            case 4:
                timKiem(ds);
                break;

            case 5:
                themNhanVien(ds);
                break;

            case 6:
                xoaNhanVien(ds);
                break;

            case 0:
                cout << "Ket thuc chuong trinh!\n";
                break;

            default:
                cout << "Lua chon khong hop le!\n";
        }

    } while (chon != 0);

    return 0;
}
